# Exposed host port for core Open WebUI
OPENWEBUI_CORE_PORT=3000

# Connect Open WebUI to local Ollama
OLLAMA_BASE_URL=http://ollama:11434

# Enable authentication (recommended for exposed ports)
WEBUI_AUTH=True

# Optional: name of this instance
WEBUI_NAME=Local AI Core

ENABLE_RAG_WEB_SEARCH=true
RAG_WEB_SEARCH_ENGINE=searxng
RAG_WEB_SEARCH_RESULT_COUNT=5
RAG_WEB_SEARCH_CONCURRENT_REQUESTS=8
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
