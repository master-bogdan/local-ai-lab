# Exposed host port for core Open WebUI
OPENWEBUI_CORE_PORT=3000

# Connect Open WebUI to local Ollama
OLLAMA_BASE_URL=http://ollama:11434

# Enable authentication (recommended for exposed ports)
WEBUI_AUTH=True

# Optional: name of this instance
WEBUI_NAME=Local AI Core

# Deep research / web search with Tavily (optional, remote SaaS)
# Sign up at https://tavily.com and paste your key here if you want web search.
TAVILY_API_KEY=

# You can define default models inside the UI later.
