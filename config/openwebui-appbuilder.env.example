# Exposed host port for App Builder instance
OPENWEBUI_APPBUILDER_PORT=3001

# Same Ollama endpoint
OLLAMA_BASE_URL=http://ollama:11434

WEBUI_AUTH=True
WEBUI_NAME=App Builder AI

